{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "啟動後端 (Node)",
      "type": "shell",
      "command": "node webtest.js",
      "isBackground": true,
      "problemMatcher": {
        "owner": "node-backend",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Server is running on port"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev",
        "focus": false
      }
    },
    {
      "label": "啟動前端預覽 (Live Server)",
      "type": "shell",
      "command": "npx --yes live-server --port=5500 --host=127.0.0.1 --open=loginpage.html --watch=.",
      "isBackground": true,
      "problemMatcher": {
        "owner": "live-server",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Serving|http://127.0.0.1:5500"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev",
        "focus": true
      }
    },
    {
      "label": "啟動完整開發環境 (後端 + 預覽)",
      "dependsOn": ["啟動後端 (Node)", "啟動前端預覽 (Live Server)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
